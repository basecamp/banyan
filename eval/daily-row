#!/usr/bin/env bash
# daily-row <owner/repo> <YYYY-MM-DD> [<shape>]: a queue's row for one day, 01:17Z to 21:17Z, from the
# eval's live score over its tick records and its take-outs from GitHub, kept under
# $BANYAN_ROWS/<repo>/rows as <day>.json and <day>.md with a line in rows.tsv. <shape> adds the
# simulated row beside it. The day's first whole row is the row: a later run changes nothing, and
# only posts it where that is still owed. With $BANYAN_ROW_POST set, the Markdown goes to that
# command's stdin once and its answer is kept in <day>.posted. Any failure exits non-zero with
# nothing of the day replaced. $BANYAN_EVAL is the eval's binary, $BANYAN_GH the gh reads go through.
set -euo pipefail
repo=$1 day=$2 shape=${3:-}
here=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
eval_bin=${BANYAN_EVAL:?the eval binary}
dir=${BANYAN_ROWS:-$HOME/.local/state/banyan-rows}/${repo##*/}
rows=$dir/rows
from=${day}T01:17:00Z to=${day}T21:17:00Z
mkdir -p "$rows"
committed() {
  jq -e '.live.commit | test("^[0-9a-f]{40}$")' "$1" > /dev/null && return 0
  echo "daily-row: the eval is not built from a commit ($(jq -r .live.commit "$1")), so its row is not posted" >&2; exit 1
}

if [ ! -s "$rows/$day.json" ]; then
  [ "$(date -u +%s)" -ge "$(date -u -d "$to" +%s)" ] || { echo "daily-row: $day's window is still open" >&2; exit 2; }
  "$here/fetch-ticks" "$repo" "$dir" "$(date -u -d "$from - 72 hours" +%FT%TZ)" "$(date -u -d "$to + 5 minutes" +%FT%TZ)" >&2
  tmp=$(mktemp -d "$rows/.$day.XXXXXX"); trap 'rm -rf "$tmp"' EXIT
  like=(); [ -n "$shape" ] && like=(-like "$shape")
  "$eval_bin" -live "$dir/ticks" -from "$from" -to "$to" "${like[@]}" -row > "$tmp/live.json"
  "$eval_bin" -takeouts "$repo" -from "$from" -to "$to" > "$tmp/takeouts.json"
  jq -n --arg repo "$repo" --arg day "$day" --arg made "$(date -u +%FT%TZ)" --slurpfile live "$tmp/live.json" --slurpfile out "$tmp/takeouts.json" \
    '{repo: $repo, day: $day, made: $made, live: $live[0], takeouts: $out[0]}' > "$tmp/row.json"
  jq -e '.live.landed != null and .live.ticks > 0 and (.takeouts.takeouts | type) == "array"' "$tmp/row.json" > /dev/null
  [ -z "${BANYAN_ROW_POST:-}" ] || committed "$tmp/row.json"
  jq -r -f "$here/daily-row.jq" "$tmp/row.json" > "$tmp/row.md"
  [ -s "$tmp/row.md" ]
  header=$(printf '%b' 'day\tmade\tcommit\tlanded\tready_p50_min\tready_p90_min\tadded_p50_min\tadded_p90_min\tover_30\tsplit\tbuilds_per_landing\ttakeouts\tpassed_later\tnot_read\tlongest_gap_min\twrong\tunchecked\tsim_over_live')
  if [ -e "$dir/rows.tsv" ] && [ "$(head -1 "$dir/rows.tsv")" != "$header" ]; then
    mv "$dir/rows.tsv" "$dir/rows.$(date -u +%Y%m%dT%H%M%SZ).tsv"
  fi
  {
    printf '%s\n' "$header"
    [ -e "$dir/rows.tsv" ] && awk -F'\t' -v day="$day" 'NR > 1 && $1 != day' "$dir/rows.tsv"
    jq -r '[.day, .made, (.live.commit | if endswith("+") then .[0:12] + "+" else .[0:12] end), .live.landed, .live.wait_p50_minutes, .live.wait_p90_minutes,
      .live.queue_added_p50_minutes, .live.queue_added_p90_minutes, .live.queue_added_over_30, .live.split_landings,
      .live.builds_per_landing, (.takeouts.takeouts | length), ([.takeouts.takeouts[] | select((.failed_then_passed // []) | length > 0)] | length),
      (.takeouts.unread // 0), .live.longest_ready_gap_minutes, .live.wrong_ejections, ((.live.unchecked // 0) + (.live.unreadable // 0)),
      ((.live.over_live // {}) | [.wait_p50, .wait_p90, .builds_per_landing, .landed] | map(if . == null then "" else (. * 100 | round | tostring) end) | join("/"))]
      | map(if . == null then "" elif type == "number" then (. * 100 | round / 100) else . end) | @tsv' "$tmp/row.json"
  } > "$tmp/rows.tsv"
  mv "$tmp/row.md" "$rows/$day.md"; mv "$tmp/live.json" "$rows/$day.live.json"; mv "$tmp/takeouts.json" "$rows/$day.takeouts.json"
  mv "$tmp/rows.tsv" "$dir/rows.tsv"; mv "$tmp/row.json" "$rows/$day.json"
fi

if [ -n "${BANYAN_ROW_POST:-}" ] && [ ! -e "$rows/$day.posted" ]; then
  committed "$rows/$day.json"
  answer=$($BANYAN_ROW_POST < "$rows/$day.md") || { echo "daily-row: $repo $day was made and could not be posted" >&2; exit 1; }
  printf '%s %s\n' "$(date -u +%FT%TZ)" "$answer" > "$rows/.$day.posted"
  mv "$rows/.$day.posted" "$rows/$day.posted"
fi
echo "daily-row: $repo $day at $(jq -r '.live.commit | .[0:12] + (if endswith("+") then "+" else "" end)' "$rows/$day.json"), made $(jq -r .made "$rows/$day.json"), $(cat "$rows/$day.posted" 2>/dev/null || echo 'not posted')" >&2
